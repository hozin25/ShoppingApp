el-col>\r\n                <el-col :span=\"12\">\r\n                    <el-form-item class=\"select\" v-if=\"type!='info'\"  label=\"支付类型\" prop=\"shangpinOrderPaymentTypes\">\r\n                        <el-select v-model=\"ruleForm.shangpinOrderPaymentTypes\" :disabled=\"ro.shangpinOrderPaymentTypes\" placeholder=\"请选择支付类型\">\r\n                            <el-option\r\n                                v-for=\"(item,index) in shangpinOrderPaymentTypesOptions\"\r\n                                v-bind:key=\"item.codeIndex\"\r\n                                :label=\"item.indexName\"\r\n                                :value=\"item.codeIndex\">\r\n                            </el-option>\r\n                        </el-select>\r\n                    </el-form-item>\r\n                    <div v-else-if=\"type=='info'\">\r\n                        <el-form-item class=\"input\" label=\"支付类型\" prop=\"shangpinOrderPaymentValue\">\r\n                        <el-input v-model=\"ruleForm.shangpinOrderPaymentValue\"\r\n                            placeholder=\"支付类型\" readonly></el-input>\r\n                        </el-form-item>\r\n                    </div>\r\n                </el-col>\r\n            </el-row>\r\n            <el-form-item class=\"btn\">\r\n                <el-button v-if=\"type!='info'\" type=\"primary\" class=\"btn-success\" @click=\"onSubmit\">提交</el-button>\r\n                <el-button v-if=\"type!='info'\" class=\"btn-close\" @click=\"back()\">取消</el-button>\r\n                <el-button v-if=\"type=='info'\" class=\"btn-close\" @click=\"back()\">返回</el-button>\r\n            </el-form-item>\r\n        </el-form>\r\n    </div>\r\n</template>\r\n<script>\r\n    import styleJs from \"../../../utils/style.js\";\r\n    // 数字，邮件，手机，url，身份证校验\r\n    import { isNumber,isIntNumer,isEmail,isPhone, isMobile,isURL,checkIdCard } from \"@/utils/validate\";\r\n    import utilsJs, {getYearFormat,getMonthFormat,getDateFormat,getDatetimeFormat} from \"../../../utils